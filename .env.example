# Copy to .env only if you need non-default local values. Do not use these defaults in AWS.
CALMOS_HTTP_PORT=8090
CALMOS_DB_NAME=calmos_survey
CALMOS_DB_USER=calmos
CALMOS_DB_PASSWORD=replace-before-any-non-local-use
CALMOS_DB_ROOT_PASSWORD=replace-before-any-non-local-use
CALMOS_ADMIN_USER=calmos-admin
CALMOS_ADMIN_PASSWORD=replace-before-any-non-local-use
CALMOS_ADMIN_NAME=CALMOS Administrator
CALMOS_ADMIN_EMAIL=admin@calmos.local
